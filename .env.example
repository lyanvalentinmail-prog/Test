# qr (predeterminado) o pairing-code
AUTH_METHOD=qr
# Solo pairing-code. Número completo con código de país, sin + ni espacios.
PAIRING_NUMBER=5215555555555

# Número del dueño, sin + ni espacios. Puede ser una lista separada por comas.
OWNER_NUMBERS=5215555555555
PREFIX=.
BOT_NAME=AI

# Opcional: habilita chat, ask y grammar con OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional para .imagine. Usa un endpoint compatible con OpenAI Images.
IMAGE_MODEL=gpt-image-1

# Límite diario por usuario para comandos marcados con Ⓛ.
USER_DAILY_LIMIT=20
